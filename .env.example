# Alt herunder er VALGFRIT – appen kører uden nogen .env-fil overhovedet.
# Alle datakilder (Energi Data Service, Open-Meteo, Frankfurter.app, OK,
# Circle K/Ingo) er gratis og kræver ingen nøgle eller hemmelighed.

# Hvilken by benzinkortet (api/benzin.ts) filtrerer stationer til.
# Matcher også varianter som "Aarhus C". Default: Aarhus
FUEL_CITY=Aarhus
